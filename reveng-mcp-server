#!/usr/bin/env python3
"""
REVENG MCP Server - Standalone Entry Point
===========================================

Launch the REVENG Enterprise MCP Server for AI agent integration.

Usage:
    # Run via stdio (for direct AI integration)
    ./reveng-mcp-server

    # Run via HTTP (for network access)
    ./reveng-mcp-server --transport http --port 8080

    # With custom configuration
    ./reveng-mcp-server --config /path/to/config.json

Example MCP Client Configuration (~/.config/claude/mcp.json):
    {
      "mcpServers": {
        "reveng": {
          "command": "/path/to/reveng-mcp-server",
          "args": [],
          "env": {
            "GEMINI_API_KEY": "your-api-key"
          }
        }
      }
    }

Author: REVENG Development Team
Version: 4.0.0
License: MIT
"""

import argparse
import asyncio
import logging
import sys
from pathlib import Path

# Add src to path
sys.path.insert(0, str(Path(__file__).parent / "src"))

from reveng.agent_sdk.mcp.servers.reveng_enterprise_server import REVENGEnterpriseServer
from reveng.agent_sdk.mcp.transports import HTTPTransport, StdioTransport

# Ensure .reveng directory exists
reveng_dir = Path.home() / ".reveng"
reveng_dir.mkdir(parents=True, exist_ok=True)

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    handlers=[
        logging.FileHandler(reveng_dir / "mcp_server.log"),
        logging.StreamHandler(sys.stderr)
    ]
)

logger = logging.getLogger(__name__)


async def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(
        description="REVENG Enterprise MCP Server - AI-Powered Reverse Engineering",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Run with stdio transport (default)
  %(prog)s

  # Run with HTTP transport
  %(prog)s --transport http --port 8080

  # Disable rate limiting for testing
  %(prog)s --no-rate-limit

  # Disable audit logging
  %(prog)s --no-audit-log

For more information, visit: https://github.com/oimiragieo/reveng-main
        """
    )

    parser.add_argument(
        "--transport",
        choices=["stdio", "http"],
        default="stdio",
        help="Transport type (default: stdio)"
    )

    parser.add_argument(
        "--port",
        type=int,
        default=8080,
        help="HTTP port (default: 8080)"
    )

    parser.add_argument(
        "--host",
        default="127.0.0.1",
        help="HTTP host (default: 127.0.0.1)"
    )

    parser.add_argument(
        "--no-rate-limit",
        action="store_true",
        help="Disable rate limiting"
    )

    parser.add_argument(
        "--no-audit-log",
        action="store_true",
        help="Disable audit logging"
    )

    parser.add_argument(
        "--config",
        type=Path,
        help="Path to configuration file"
    )

    parser.add_argument(
        "--debug",
        action="store_true",
        help="Enable debug logging"
    )

    parser.add_argument(
        "--version",
        action="version",
        version="REVENG MCP Server v4.0.0"
    )

    args = parser.parse_args()

    # Configure debug logging
    if args.debug:
        logging.getLogger().setLevel(logging.DEBUG)
        logger.debug("Debug logging enabled")

    # Create server
    logger.info("Initializing REVENG Enterprise MCP Server v4.0.0")

    server = REVENGEnterpriseServer(
        enable_rate_limiting=not args.no_rate_limit,
        enable_audit_log=not args.no_audit_log
    )

    # Create transport
    if args.transport == "stdio":
        logger.info("Using stdio transport (AI agent mode)")
        transport = StdioTransport()
    else:
        logger.info(f"Using HTTP transport on {args.host}:{args.port}")
        transport = HTTPTransport(host=args.host, port=args.port)

    # Start server
    try:
        logger.info("Starting REVENG MCP Server...")
        logger.info(f"Rate limiting: {'enabled' if not args.no_rate_limit else 'disabled'}")
        logger.info(f"Audit logging: {'enabled' if not args.no_audit_log else 'disabled'}")
        logger.info("=" * 70)
        logger.info("REVENG MCP Server is ready for AI agent connections")
        logger.info("=" * 70)

        await server.start(transport)

    except KeyboardInterrupt:
        logger.info("Received shutdown signal")
    except Exception as e:
        logger.exception(f"Server error: {e}")
        sys.exit(1)
    finally:
        logger.info("Shutting down REVENG MCP Server")
        await server.stop()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\nShutdown complete", file=sys.stderr)
        sys.exit(0)
