#!/usr/bin/env python3
"""
REVENG JavaScript Deobfuscation - Standalone CLI

Standalone entry point that doesn't require the full REVENG package.
Just the JavaScript deobfuscation module.

Usage:
    ./reveng-js deobfuscate input.js -o output.js
    python reveng-js deobfuscate input.js --ml --llm gpt4
"""

import sys
from pathlib import Path

# Add src to path for imports
sys.path.insert(0, str(Path(__file__).parent / "src"))

# Now we can import - but we need to do it ONLY from javascript module
# to avoid triggering the broken reveng.__init__.py
import asyncio
import argparse
import json

# Import directly from submodules to avoid reveng.__init__.py
from reveng.javascript.deobfuscator import JavaScriptDeobfuscator
from reveng.javascript.malware_detector import MalwareDetector
from reveng.javascript.cache_system import DeobfuscationCache
from reveng.javascript.source_map_recoverer import SourceMapRecoverer
from reveng.javascript.detectors import ObfuscationDetector


def create_parser():
    """Create argument parser"""
    parser = argparse.ArgumentParser(
        prog="reveng-js",
        description="REVENG v4.0 - World-Class JavaScript Deobfuscation",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Deobfuscate single file
  ./reveng-js deobfuscate input.js -o output.js

  # Use ML (requires unuglify-js)
  ./reveng-js deobfuscate input.js --ml -o output.js

  # Use ML + LLM (best quality, costs money)
  ./reveng-js deobfuscate input.js --ml --llm gpt4 -o output.js

  # Malware analysis
  ./reveng-js analyze malware.js

  # Detect obfuscation types
  ./reveng-js detect obfuscated.js

  # Cache management
  ./reveng-js cache --stats
  ./reveng-js cache --clear

For more information: https://github.com/oimiragieo/reveng-main
        """,
    )

    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # Deobfuscate command
    deob_parser = subparsers.add_parser(
        "deobfuscate", help="Deobfuscate JavaScript file"
    )
    deob_parser.add_argument("input", help="Input JavaScript file")
    deob_parser.add_argument("-o", "--output", help="Output file (default: print to stdout)")
    deob_parser.add_argument(
        "--ml", action="store_true", help="Use ML variable renaming (requires unuglify-js)"
    )
    deob_parser.add_argument(
        "--llm", choices=["gpt4", "claude", "local"], help="Use LLM enhancement (costs money!)"
    )
    deob_parser.add_argument(
        "--no-cache", action="store_true", help="Disable caching"
    )
    deob_parser.add_argument(
        "--format", choices=["js", "json"], default="js", help="Output format"
    )
    deob_parser.add_argument(
        "-v", "--verbose", action="store_true", help="Verbose output"
    )

    # Analyze command
    analyze_parser = subparsers.add_parser("analyze", help="Analyze for malware")
    analyze_parser.add_argument("input", help="Input JavaScript file")
    analyze_parser.add_argument("--json", help="Export JSON report")

    # Detect command
    detect_parser = subparsers.add_parser("detect", help="Detect obfuscation types")
    detect_parser.add_argument("input", help="Input JavaScript file")

    # Cache command
    cache_parser = subparsers.add_parser("cache", help="Manage cache")
    cache_parser.add_argument(
        "--stats", action="store_true", help="Show cache statistics"
    )
    cache_parser.add_argument("--clear", action="store_true", help="Clear cache")
    cache_parser.add_argument(
        "--cleanup",
        type=int,
        metavar="DAYS",
        help="Remove entries older than N days",
    )

    return parser


async def cmd_deobfuscate(args):
    """Deobfuscate command"""
    if args.verbose:
        print(f"🔄 Deobfuscating: {args.input}")

    # Read input
    try:
        with open(args.input, "r") as f:
            code = f.read()
    except FileNotFoundError:
        print(f"❌ Error: File not found: {args.input}")
        return 1
    except Exception as e:
        print(f"❌ Error reading file: {e}")
        return 1

    # Check cache
    cache = None if args.no_cache else DeobfuscationCache()

    if cache:
        cached = cache.get(code)
        if cached:
            if args.verbose:
                print(f"✅ Found in cache (saved {cached.processing_time:.2f}s)")
            result_code = cached.deobfuscated_code
            confidence = cached.confidence
        else:
            if args.verbose:
                print("⚠️  Cache miss - running deobfuscation...")
            result_code, confidence = await deobfuscate_with_cache(code, args, cache)
    else:
        # Deobfuscate
        deob = JavaScriptDeobfuscator(
            use_ml=args.ml,
            use_llm=bool(args.llm),
            llm_provider=args.llm if args.llm else "gpt4",
        )

        result = await deob.deobfuscate(code)
        result_code = result.deobfuscated_code
        confidence = result.confidence

    if args.verbose:
        print(f"✅ Deobfuscation complete (confidence: {confidence:.1%})")

    # Output
    if args.output:
        if args.format == "json":
            output_data = {
                "original_file": args.input,
                "deobfuscated_code": result_code,
                "confidence": confidence,
            }
            with open(args.output, "w") as f:
                json.dump(output_data, f, indent=2)
        else:
            with open(args.output, "w") as f:
                f.write(result_code)

        print(f"💾 Saved to: {args.output}")
    else:
        print(result_code)

    return 0


async def deobfuscate_with_cache(code, args, cache):
    """Deobfuscate and cache result"""
    import time

    deob = JavaScriptDeobfuscator(
        use_ml=args.ml,
        use_llm=bool(args.llm),
        llm_provider=args.llm if args.llm else "gpt4",
    )

    start = time.time()
    result = await deob.deobfuscate(code)
    processing_time = time.time() - start

    # Cache result
    cache.put(
        code,
        result.deobfuscated_code,
        result.confidence,
        [t.value for t in result.obfuscation_types],
        processing_time,
    )

    return result.deobfuscated_code, result.confidence


async def cmd_analyze(args):
    """Analyze for malware"""
    print(f"🔍 Analyzing: {args.input}")

    # Read code
    try:
        with open(args.input, "r") as f:
            code = f.read()
    except FileNotFoundError:
        print(f"❌ Error: File not found: {args.input}")
        return 1

    # Deobfuscate first
    deob = JavaScriptDeobfuscator(use_ml=True, use_llm=False)
    deob_result = await deob.deobfuscate(code)

    # Malware detection
    detector = MalwareDetector()
    malware_result = detector.analyze(deob_result.deobfuscated_code)

    # Print summary
    print(f"\n{'='*70}")
    print(f"🔒 Malware Analysis Results")
    print(f"{'='*70}")
    print(f"Is Malicious: {'🚨 YES' if malware_result.is_malicious else '✅ NO'}")
    print(f"Threat Score: {malware_result.threat_score:.1%}")
    print(f"Indicators: {len(malware_result.indicators)}")

    if malware_result.indicators:
        print(f"\n🚨 Threat Indicators:")
        for i, indicator in enumerate(malware_result.indicators[:10], 1):
            print(f"  {i}. [{indicator.category.value.upper()}] {indicator.description}")

        if len(malware_result.indicators) > 10:
            print(f"  ... and {len(malware_result.indicators) - 10} more")

    if malware_result.recommendations:
        print(f"\n💡 Recommendations:")
        for rec in malware_result.recommendations[:5]:
            print(f"  • {rec}")

    # JSON export
    if args.json:
        with open(args.json, "w") as f:
            json.dump(
                {
                    "is_malicious": malware_result.is_malicious,
                    "threat_score": malware_result.threat_score,
                    "indicators": [
                        {
                            "category": ind.category.value,
                            "level": ind.level.value,
                            "description": ind.description,
                        }
                        for ind in malware_result.indicators
                    ],
                    "recommendations": malware_result.recommendations,
                },
                f,
                indent=2,
            )
        print(f"\n📄 JSON report saved to: {args.json}")

    return 0


def cmd_detect(args):
    """Detect obfuscation types"""
    print(f"🔍 Detecting obfuscation types: {args.input}")

    # Read code
    try:
        with open(args.input, "r") as f:
            code = f.read()
    except FileNotFoundError:
        print(f"❌ Error: File not found: {args.input}")
        return 1

    detector = ObfuscationDetector()
    result = detector.detect(code)

    print(f"\n✅ Detected {len(result.obfuscation_types)} obfuscation type(s):")
    for obf_type in result.obfuscation_types:
        print(f"  • {obf_type.value}")

    print(f"\n📊 Confidence: {result.confidence:.1%}")

    if result.details:
        print(f"\n📝 Details:")
        for key, value in result.details.items():
            print(f"  {key}: {value}")

    return 0


def cmd_cache(args):
    """Cache management"""
    cache = DeobfuscationCache()

    if args.stats:
        stats = cache.get_stats()
        print(f"\n📊 Cache Statistics:")
        print(f"  Memory entries: {stats['memory_entries']}")
        print(f"  Disk entries: {stats['disk_entries']}")
        print(f"  Disk size: {stats['disk_size_mb']:.2f} MB")
        print(f"  Cache hits: {stats['hits']}")
        print(f"  Cache misses: {stats['misses']}")
        hit_rate = stats['hit_rate']
        print(f"  Hit rate: {hit_rate:.1%}" if isinstance(hit_rate, float) else f"  Hit rate: N/A")
        print(f"  Evictions: {stats['evictions']}")

    if args.clear:
        cache.clear()
        print("✅ Cache cleared")

    if args.cleanup:
        removed = cache.cleanup_old_entries(args.cleanup)
        print(f"✅ Cleaned up {removed} old entries")

    return 0


async def main():
    """Main entry point"""
    parser = create_parser()
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        print("\n💡 Tip: Run './reveng-js deobfuscate --help' for more information")
        print("💡 Tip: Run 'python examples/javascript_deobfuscation_demo.py' for examples")
        return 0

    # Dispatch to command handler
    try:
        if args.command == "deobfuscate":
            return await cmd_deobfuscate(args)
        elif args.command == "analyze":
            return await cmd_analyze(args)
        elif args.command == "detect":
            return cmd_detect(args)
        elif args.command == "cache":
            return cmd_cache(args)
    except KeyboardInterrupt:
        print("\n\n⚠️  Interrupted by user")
        return 130
    except Exception as e:
        print(f"\n❌ Error: {e}")
        import traceback
        traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(asyncio.run(main()) or 0)
