# REVENG environment variable reference
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# AI Provider selection
# ---------------------------------------------------------------------------
# Which LLM provider to use for analysis. Options: ollama, anthropic, openai
# Default when unset: ollama (local, no API key required)
REVENG_AI_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Anthropic (Claude) — required when REVENG_AI_PROVIDER=anthropic
# ---------------------------------------------------------------------------
# Obtain at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ---------------------------------------------------------------------------
# OpenAI (GPT) — required when REVENG_AI_PROVIDER=openai
# ---------------------------------------------------------------------------
# Obtain at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
